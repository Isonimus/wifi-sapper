{
  "name": "esp32-wifi-sapper",
  "private": true,
  "version": "0.0.0",
  "description": "WiFi Sapper — portable, headless-first ESP-32 handshake-autohunt appliance. This package.json is the verification script registry (ADR-0004), not a web toolchain.",
  "type": "module",
  "scripts": {
    "test:native": "pio test -e native",
    "build:boards": "pio run -e cardputer",
    "verify:device": "node scripts/0005-cardputer-bringup-verify.mjs",
    "verify:provisioning": "node scripts/0007-provisioning-verify.mjs",
    "verify:rf-sniffer": "node scripts/0012-rf-sniffer-verify.mjs",
    "verify:rf-discover": "node scripts/0014-rf-discover-verify.mjs",
    "verify:hunt": "node scripts/0016-hunt-verify.mjs",
    "verify:upload": "node scripts/0018-upload-verify.mjs",
    "verify:sync": "node scripts/0020-sync-verify.mjs",
    "verify:led": "node scripts/0022-led-verify.mjs",
    "verify:webhook": "node scripts/0024-webhook-verify.mjs",
    "verify:screen": "node scripts/0026-screen-verify.mjs",
    "verify:deauth": "node scripts/0028-deauth-verify.mjs",
    "verify:deauth-loop": "node scripts/0030-deauth-loop-verify.mjs",
    "verify:capture-notify": "node scripts/0032-capture-notify-verify.mjs",
    "verify:hunt-hud": "node scripts/0034-hunt-hud-verify.mjs",
    "verify:webhook-capture": "node scripts/0036-webhook-capture-verify.mjs",
    "verify:maintenance": "node scripts/0040-maintenance-verify.mjs",
    "verify:serial-stimulus": "node scripts/0048-serial-stimulus-verify.mjs",
    "lint": "node scripts/lint-docs.mjs .",
    "index": "node scripts/build-index.mjs ."
  },
  "devDependencies": {
    "serialport": "^12.0.0"
  }
}
